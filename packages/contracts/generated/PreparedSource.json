{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$ref": "#/$defs/PreparedSource",
  "$defs": {
    "CapturePolicy": {
      "type": "object",
      "properties": {
        "version": {
          "type": "string",
          "minLength": 1
        },
        "main": {
          "type": "integer",
          "maximum": 1000,
          "exclusiveMinimum": 0
        },
        "discussion": {
          "type": "integer",
          "maximum": 1000,
          "exclusiveMinimum": 0
        },
        "context": {
          "type": "integer",
          "maximum": 1000,
          "exclusiveMinimum": 0
        },
        "direct": {
          "type": "integer",
          "maximum": 1000,
          "exclusiveMinimum": 0
        },
        "latest": {
          "type": "integer",
          "maximum": 1000,
          "exclusiveMinimum": 0
        },
        "nestedReserve": {
          "type": "integer",
          "maximum": 1000,
          "exclusiveMinimum": 0
        },
        "preparedBytes": {
          "type": "integer",
          "maximum": 1048576,
          "exclusiveMinimum": 0
        }
      },
      "required": [
        "version",
        "main",
        "discussion",
        "context",
        "direct",
        "latest",
        "nestedReserve",
        "preparedBytes"
      ],
      "additionalProperties": true
    },
    "SourceInput": {
      "type": "object",
      "properties": {
        "kind": {
          "type": "string",
          "enum": [
            "x_post",
            "x_author_thread",
            "x_article"
          ]
        },
        "primaryId": {
          "type": "string"
        },
        "aliases": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "maxItems": 50
        },
        "resolution": {
          "type": "string",
          "enum": [
            "resolved",
            "uncertain"
          ]
        }
      },
      "required": [
        "kind",
        "primaryId",
        "aliases",
        "resolution"
      ],
      "additionalProperties": true
    },
    "XPost": {
      "type": "object",
      "properties": {
        "id": {
          "type": "string"
        },
        "authorId": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ]
        },
        "parentId": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ]
        },
        "parentStatus": {
          "type": "string",
          "enum": [
            "root",
            "reply",
            "unknown"
          ]
        },
        "conversationId": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ]
        },
        "text": {
          "type": "string",
          "maxLength": 16777216
        },
        "longText": {
          "anyOf": [
            {
              "type": "string",
              "maxLength": 16777216
            },
            {
              "type": "null"
            }
          ]
        },
        "language": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ]
        },
        "quotedId": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ]
        },
        "articleId": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ]
        },
        "postedAt": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ]
        },
        "isBot": {
          "anyOf": [
            {
              "type": "boolean"
            },
            {
              "type": "null"
            }
          ]
        },
        "references": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "kind": {
                "type": "string",
                "enum": [
                  "external_page",
                  "image",
                  "video",
                  "audio"
                ]
              },
              "url": {
                "type": "string"
              }
            },
            "required": [
              "kind",
              "url"
            ],
            "additionalProperties": true
          }
        }
      },
      "required": [
        "id",
        "authorId",
        "parentId",
        "parentStatus",
        "conversationId",
        "text",
        "longText",
        "language",
        "quotedId",
        "articleId",
        "postedAt",
        "isBot",
        "references"
      ],
      "additionalProperties": true
    },
    "RawEvidence": {
      "type": "object",
      "properties": {
        "assetId": {
          "type": "string",
          "pattern": "^([0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[1-8][0-9a-fA-F]{3}-[89abAB][0-9a-fA-F]{3}-[0-9a-fA-F]{12}|00000000-0000-0000-0000-000000000000|[fF]{8}-[fF]{4}-[fF]{4}-[fF]{4}-[fF]{12})$",
          "format": "uuid"
        },
        "sha256": {
          "type": "string"
        },
        "byteLength": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991
        },
        "provider": {
          "type": "string"
        },
        "runId": {
          "type": "string"
        },
        "page": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991
        }
      },
      "required": [
        "assetId",
        "sha256",
        "byteLength",
        "provider",
        "runId",
        "page"
      ],
      "additionalProperties": true
    },
    "AcquisitionOrigin": {
      "type": "object",
      "properties": {
        "requestKey": {
          "type": "string"
        },
        "mode": {
          "type": "string",
          "enum": [
            "anchor",
            "parents",
            "author",
            "quotes",
            "article",
            "direct",
            "latest",
            "nested"
          ]
        },
        "raw": {
          "$ref": "#/$defs/RawEvidence"
        },
        "row": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991
        }
      },
      "required": [
        "requestKey",
        "mode",
        "raw",
        "row"
      ],
      "additionalProperties": true
    },
    "PreparedPost": {
      "type": "object",
      "properties": {
        "post": {
          "$ref": "#/$defs/XPost"
        },
        "canonicalUrl": {
          "type": "string"
        },
        "role": {
          "type": "string",
          "enum": [
            "main",
            "discussion",
            "context",
            "quote"
          ]
        },
        "origins": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/AcquisitionOrigin"
          }
        },
        "textVariantDigests": {
          "type": "array",
          "items": {
            "type": "string"
          }
        }
      },
      "required": [
        "post",
        "canonicalUrl",
        "role",
        "origins",
        "textVariantDigests"
      ],
      "additionalProperties": true
    },
    "XArticle": {
      "type": "object",
      "properties": {
        "id": {
          "type": "string"
        },
        "title": {
          "type": "string"
        },
        "body": {
          "anyOf": [
            {
              "type": "string",
              "maxLength": 16777216
            },
            {
              "type": "null"
            }
          ]
        },
        "bodyStatus": {
          "type": "string",
          "enum": [
            "acquired",
            "partial",
            "preview",
            "unavailable"
          ]
        },
        "language": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ]
        },
        "references": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "kind": {
                "type": "string",
                "enum": [
                  "external_page",
                  "image",
                  "video",
                  "audio"
                ]
              },
              "url": {
                "type": "string"
              }
            },
            "required": [
              "kind",
              "url"
            ],
            "additionalProperties": true
          }
        }
      },
      "required": [
        "id",
        "title",
        "body",
        "bodyStatus",
        "language",
        "references"
      ],
      "additionalProperties": true
    },
    "PreparedArticle": {
      "type": "object",
      "properties": {
        "article": {
          "$ref": "#/$defs/XArticle"
        },
        "canonicalUrl": {
          "type": "string"
        },
        "origins": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/AcquisitionOrigin"
          }
        }
      },
      "required": [
        "article",
        "canonicalUrl",
        "origins"
      ],
      "additionalProperties": true
    },
    "PreparedMaterial": {
      "type": "object",
      "properties": {
        "source": {
          "$ref": "#/$defs/SourceInput"
        },
        "posts": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/PreparedPost"
          }
        },
        "article": {
          "anyOf": [
            {
              "$ref": "#/$defs/PreparedArticle"
            },
            {
              "type": "null"
            }
          ]
        },
        "originalText": {
          "type": "string",
          "maxLength": 1048576
        },
        "language": {
          "type": "string"
        }
      },
      "required": [
        "source",
        "posts",
        "article",
        "originalText",
        "language"
      ],
      "additionalProperties": true
    },
    "AcquisitionRequest": {
      "type": "object",
      "properties": {
        "key": {
          "type": "string"
        },
        "mode": {
          "type": "string",
          "enum": [
            "anchor",
            "parents",
            "author",
            "quotes",
            "article",
            "direct",
            "latest",
            "nested"
          ]
        },
        "allocations": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "targetId": {
                "type": "string"
              },
              "limit": {
                "type": "integer",
                "maximum": 1000,
                "exclusiveMinimum": 0
              }
            },
            "required": [
              "targetId",
              "limit"
            ],
            "additionalProperties": true
          }
        },
        "limit": {
          "type": "integer",
          "maximum": 1000,
          "exclusiveMinimum": 0
        },
        "authorId": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ]
        },
        "conversationId": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ]
        },
        "sort": {
          "type": "string",
          "enum": [
            "Latest"
          ]
        }
      },
      "required": [
        "key",
        "mode",
        "allocations",
        "limit",
        "authorId",
        "conversationId",
        "sort"
      ],
      "additionalProperties": true
    },
    "UnprocessedReference": {
      "type": "object",
      "properties": {
        "kind": {
          "type": "string",
          "enum": [
            "external_page",
            "image",
            "video",
            "audio",
            "article",
            "quote"
          ]
        },
        "url": {
          "type": "string"
        },
        "fromProviderId": {
          "type": "string"
        },
        "fromKind": {
          "type": "string",
          "enum": [
            "post",
            "article"
          ]
        },
        "reason": {
          "type": "string"
        }
      },
      "required": [
        "kind",
        "url",
        "fromProviderId",
        "fromKind",
        "reason"
      ],
      "additionalProperties": true
    },
    "PreparedSource": {
      "type": "object",
      "properties": {
        "schemaVersion": {
          "type": "number",
          "enum": [
            1
          ]
        },
        "outcome": {
          "type": "string",
          "enum": [
            "ready",
            "unavailable",
            "capacity",
            "identity_conflict"
          ]
        },
        "submittedUrl": {
          "type": "string"
        },
        "normalizedUrl": {
          "type": "string"
        },
        "anchorId": {
          "type": "string"
        },
        "policy": {
          "$ref": "#/$defs/CapturePolicy"
        },
        "materials": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/PreparedMaterial"
          },
          "maxItems": 2
        },
        "acquisitions": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "request": {
                "$ref": "#/$defs/AcquisitionRequest"
              },
              "status": {
                "type": "string",
                "enum": [
                  "succeeded",
                  "partial",
                  "unavailable",
                  "failed",
                  "budget",
                  "deadline"
                ]
              },
              "raw": {
                "type": "array",
                "items": {
                  "$ref": "#/$defs/RawEvidence"
                }
              },
              "rowCount": {
                "type": "integer",
                "minimum": 0,
                "maximum": 9007199254740991
              },
              "diagnostics": {
                "type": "array",
                "items": {
                  "type": "string",
                  "maxLength": 4096
                },
                "maxItems": 64
              }
            },
            "required": [
              "request",
              "status",
              "raw",
              "rowCount",
              "diagnostics"
            ],
            "additionalProperties": true
          }
        },
        "coverage": {
          "type": "object",
          "properties": {
            "main": {
              "type": "string",
              "enum": [
                "unavailable",
                "bounded",
                "limited",
                "uncertain"
              ]
            },
            "discussion": {
              "type": "string",
              "enum": [
                "not_acquired",
                "bounded",
                "limited"
              ]
            },
            "missingParents": {
              "type": "array",
              "items": {
                "type": "string"
              }
            },
            "warnings": {
              "type": "array",
              "items": {
                "type": "string"
              }
            },
            "unprocessed": {
              "type": "array",
              "items": {
                "$ref": "#/$defs/UnprocessedReference"
              }
            }
          },
          "required": [
            "main",
            "discussion",
            "missingParents",
            "warnings",
            "unprocessed"
          ],
          "additionalProperties": true
        },
        "counts": {
          "type": "object",
          "properties": {
            "acquiredRows": {
              "type": "integer",
              "minimum": 0,
              "maximum": 9007199254740991
            },
            "malformedRows": {
              "type": "integer",
              "minimum": 0,
              "maximum": 9007199254740991
            },
            "uniquePosts": {
              "type": "integer",
              "minimum": 0,
              "maximum": 9007199254740991
            },
            "duplicateRows": {
              "type": "integer",
              "minimum": 0,
              "maximum": 9007199254740991
            },
            "excludedPosts": {
              "type": "integer",
              "minimum": 0,
              "maximum": 9007199254740991
            },
            "main": {
              "type": "integer",
              "minimum": 0,
              "maximum": 9007199254740991
            },
            "discussion": {
              "type": "integer",
              "minimum": 0,
              "maximum": 9007199254740991
            },
            "context": {
              "type": "integer",
              "minimum": 0,
              "maximum": 9007199254740991
            },
            "parentLookups": {
              "type": "integer",
              "minimum": 0,
              "maximum": 9007199254740991
            },
            "presentedPosts": {
              "type": "integer",
              "minimum": 0,
              "maximum": 9007199254740991
            },
            "preparedBytes": {
              "type": "integer",
              "minimum": 0,
              "maximum": 9007199254740991
            }
          },
          "required": [
            "acquiredRows",
            "malformedRows",
            "uniquePosts",
            "duplicateRows",
            "excludedPosts",
            "main",
            "discussion",
            "context",
            "parentLookups",
            "presentedPosts",
            "preparedBytes"
          ],
          "additionalProperties": true
        }
      },
      "required": [
        "schemaVersion",
        "outcome",
        "submittedUrl",
        "normalizedUrl",
        "anchorId",
        "policy",
        "materials",
        "acquisitions",
        "coverage",
        "counts"
      ],
      "additionalProperties": true
    }
  }
}
