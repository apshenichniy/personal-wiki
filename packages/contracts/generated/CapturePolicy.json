{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$ref": "#/$defs/CapturePolicy",
  "$defs": {
    "CapturePolicy": {
      "type": "object",
      "properties": {
        "version": {
          "type": "string",
          "minLength": 1
        },
        "main": {
          "type": "integer",
          "maximum": 1000,
          "exclusiveMinimum": 0
        },
        "discussion": {
          "type": "integer",
          "maximum": 1000,
          "exclusiveMinimum": 0
        },
        "context": {
          "type": "integer",
          "maximum": 1000,
          "exclusiveMinimum": 0
        },
        "direct": {
          "type": "integer",
          "maximum": 1000,
          "exclusiveMinimum": 0
        },
        "latest": {
          "type": "integer",
          "maximum": 1000,
          "exclusiveMinimum": 0
        },
        "nestedReserve": {
          "type": "integer",
          "maximum": 1000,
          "exclusiveMinimum": 0
        },
        "preparedBytes": {
          "type": "integer",
          "maximum": 1048576,
          "exclusiveMinimum": 0
        }
      },
      "required": [
        "version",
        "main",
        "discussion",
        "context",
        "direct",
        "latest",
        "nestedReserve",
        "preparedBytes"
      ],
      "additionalProperties": true
    }
  }
}
