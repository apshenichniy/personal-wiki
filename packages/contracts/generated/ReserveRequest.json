{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$ref": "#/$defs/ReserveRequest",
  "$defs": {
    "SourceInput": {
      "type": "object",
      "properties": {
        "kind": {
          "type": "string",
          "enum": [
            "x_post",
            "x_author_thread",
            "x_article"
          ]
        },
        "primaryId": {
          "type": "string"
        },
        "aliases": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "maxItems": 50
        },
        "resolution": {
          "type": "string",
          "enum": [
            "resolved",
            "uncertain"
          ]
        }
      },
      "required": [
        "kind",
        "primaryId",
        "aliases",
        "resolution"
      ],
      "additionalProperties": true
    },
    "ReserveRequest": {
      "type": "object",
      "properties": {
        "requestId": {
          "type": "string",
          "pattern": "^([0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[1-8][0-9a-fA-F]{3}-[89abAB][0-9a-fA-F]{3}-[0-9a-fA-F]{12}|00000000-0000-0000-0000-000000000000|[fF]{8}-[fF]{4}-[fF]{4}-[fF]{4}-[fF]{12})$",
          "format": "uuid"
        },
        "sources": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/SourceInput"
          },
          "minItems": 1,
          "maxItems": 2
        }
      },
      "required": [
        "requestId",
        "sources"
      ],
      "additionalProperties": true
    }
  }
}
