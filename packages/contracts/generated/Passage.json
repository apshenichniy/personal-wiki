{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "heading": {
      "anyOf": [
        {
          "type": "string",
          "maxLength": 240
        },
        {
          "type": "null"
        }
      ]
    },
    "text": {
      "type": "string",
      "minLength": 1,
      "maxLength": 16000
    },
    "attribution": {
      "type": "string",
      "enum": [
        "source",
        "participant",
        "inference"
      ]
    },
    "supports": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "minItems": 1,
      "maxItems": 50
    }
  },
  "required": [
    "heading",
    "text",
    "attribution",
    "supports"
  ],
  "additionalProperties": true,
  "$defs": {}
}
