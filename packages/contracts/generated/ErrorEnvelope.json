{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "code": {
      "type": "string",
      "enum": [
        "invalid_request",
        "internal_error",
        "idempotency_conflict",
        "stale_proposal",
        "already_published",
        "revision_changed",
        "not_found",
        "unavailable",
        "cancelled",
        "invalid_transition",
        "deadline_exceeded",
        "launch_limit",
        "stale_owner",
        "unauthenticated",
        "forbidden"
      ]
    },
    "message": {
      "type": "string"
    },
    "requestId": {
      "type": "string",
      "pattern": "^([0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[1-8][0-9a-fA-F]{3}-[89abAB][0-9a-fA-F]{3}-[0-9a-fA-F]{12}|00000000-0000-0000-0000-000000000000|[fF]{8}-[fF]{4}-[fF]{4}-[fF]{4}-[fF]{12})$",
      "format": "uuid"
    }
  },
  "required": [
    "code",
    "message",
    "requestId"
  ],
  "additionalProperties": true,
  "$defs": {}
}
