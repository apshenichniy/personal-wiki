{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "operationId": {
      "type": "string",
      "pattern": "^([0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[1-8][0-9a-fA-F]{3}-[89abAB][0-9a-fA-F]{3}-[0-9a-fA-F]{12}|00000000-0000-0000-0000-000000000000|[fF]{8}-[fF]{4}-[fF]{4}-[fF]{4}-[fF]{12})$",
      "format": "uuid"
    },
    "kind": {
      "type": "string",
      "enum": [
        "run",
        "dataset",
        "report"
      ]
    },
    "offset": {
      "type": "integer",
      "minimum": 0,
      "maximum": 9007199254740991
    },
    "total": {
      "type": "integer",
      "minimum": 0,
      "maximum": 9007199254740991
    },
    "sha256": {
      "type": "string"
    },
    "base64": {
      "type": "string",
      "maxLength": 22369624
    }
  },
  "required": [
    "operationId",
    "kind",
    "offset",
    "total",
    "sha256",
    "base64"
  ],
  "additionalProperties": true,
  "$defs": {}
}
