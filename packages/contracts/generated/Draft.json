{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$ref": "#/$defs/Draft",
  "$defs": {
    "Source": {
      "type": "object",
      "properties": {
        "schemaVersion": {
          "type": "number",
          "enum": [
            1
          ]
        },
        "sourceId": {
          "type": "string",
          "pattern": "^([0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[1-8][0-9a-fA-F]{3}-[89abAB][0-9a-fA-F]{3}-[0-9a-fA-F]{12}|00000000-0000-0000-0000-000000000000|[fF]{8}-[fF]{4}-[fF]{4}-[fF]{4}-[fF]{12})$",
          "format": "uuid"
        },
        "kind": {
          "type": "string",
          "enum": [
            "x_post",
            "x_author_thread",
            "x_article"
          ]
        },
        "primaryId": {
          "type": "string"
        },
        "aliases": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "maxItems": 50
        },
        "resolution": {
          "type": "string",
          "enum": [
            "resolved",
            "uncertain"
          ]
        },
        "externalKey": {
          "type": "string"
        },
        "canonicalUrl": {
          "type": "string"
        }
      },
      "required": [
        "schemaVersion",
        "sourceId",
        "kind",
        "primaryId",
        "aliases",
        "resolution",
        "externalKey",
        "canonicalUrl"
      ],
      "additionalProperties": true
    },
    "Slot": {
      "type": "object",
      "properties": {
        "source": {
          "$ref": "#/$defs/Source"
        },
        "noteId": {
          "type": "string",
          "pattern": "^([0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[1-8][0-9a-fA-F]{3}-[89abAB][0-9a-fA-F]{3}-[0-9a-fA-F]{12}|00000000-0000-0000-0000-000000000000|[fF]{8}-[fF]{4}-[fF]{4}-[fF]{4}-[fF]{12})$",
          "format": "uuid"
        },
        "captureId": {
          "type": "string",
          "pattern": "^([0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[1-8][0-9a-fA-F]{3}-[89abAB][0-9a-fA-F]{3}-[0-9a-fA-F]{12}|00000000-0000-0000-0000-000000000000|[fF]{8}-[fF]{4}-[fF]{4}-[fF]{4}-[fF]{12})$",
          "format": "uuid"
        },
        "representationId": {
          "type": "string",
          "pattern": "^([0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[1-8][0-9a-fA-F]{3}-[89abAB][0-9a-fA-F]{3}-[0-9a-fA-F]{12}|00000000-0000-0000-0000-000000000000|[fF]{8}-[fF]{4}-[fF]{4}-[fF]{4}-[fF]{12})$",
          "format": "uuid"
        },
        "assetId": {
          "type": "string",
          "pattern": "^([0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[1-8][0-9a-fA-F]{3}-[89abAB][0-9a-fA-F]{3}-[0-9a-fA-F]{12}|00000000-0000-0000-0000-000000000000|[fF]{8}-[fF]{4}-[fF]{4}-[fF]{4}-[fF]{12})$",
          "format": "uuid"
        }
      },
      "required": [
        "source",
        "noteId",
        "captureId",
        "representationId",
        "assetId"
      ],
      "additionalProperties": true
    },
    "Draft": {
      "type": "object",
      "properties": {
        "schemaVersion": {
          "type": "number",
          "enum": [
            1
          ]
        },
        "jobId": {
          "type": "string",
          "pattern": "^([0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[1-8][0-9a-fA-F]{3}-[89abAB][0-9a-fA-F]{3}-[0-9a-fA-F]{12}|00000000-0000-0000-0000-000000000000|[fF]{8}-[fF]{4}-[fF]{4}-[fF]{4}-[fF]{12})$",
          "format": "uuid"
        },
        "slots": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/Slot"
          }
        }
      },
      "required": [
        "schemaVersion",
        "jobId",
        "slots"
      ],
      "additionalProperties": true
    }
  }
}
