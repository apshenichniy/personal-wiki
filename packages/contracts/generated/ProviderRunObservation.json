{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "runId": {
      "type": "string",
      "minLength": 1,
      "maxLength": 512
    },
    "status": {
      "type": "string",
      "enum": [
        "READY",
        "RUNNING",
        "SUCCEEDED",
        "FAILED",
        "TIMING-OUT",
        "TIMED-OUT",
        "ABORTING",
        "ABORTED"
      ]
    },
    "finishedAt": {
      "anyOf": [
        {
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991
        },
        {
          "type": "null"
        }
      ]
    },
    "usageNanos": {
      "anyOf": [
        {
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991
        },
        {
          "type": "null"
        }
      ]
    },
    "transientFailure": {
      "type": "boolean"
    }
  },
  "required": [
    "runId",
    "status",
    "finishedAt",
    "usageNanos",
    "transientFailure"
  ],
  "additionalProperties": true,
  "$defs": {}
}
