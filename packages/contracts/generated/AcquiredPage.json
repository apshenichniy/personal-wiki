{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$ref": "#/$defs/AcquiredPage",
  "$defs": {
    "RawEvidence": {
      "type": "object",
      "properties": {
        "assetId": {
          "type": "string",
          "pattern": "^([0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[1-8][0-9a-fA-F]{3}-[89abAB][0-9a-fA-F]{3}-[0-9a-fA-F]{12}|00000000-0000-0000-0000-000000000000|[fF]{8}-[fF]{4}-[fF]{4}-[fF]{4}-[fF]{12})$",
          "format": "uuid"
        },
        "sha256": {
          "type": "string"
        },
        "byteLength": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991
        },
        "provider": {
          "type": "string"
        },
        "runId": {
          "type": "string"
        },
        "page": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991
        }
      },
      "required": [
        "assetId",
        "sha256",
        "byteLength",
        "provider",
        "runId",
        "page"
      ],
      "additionalProperties": true
    },
    "AcquiredPage": {
      "type": "object",
      "properties": {
        "raw": {
          "$ref": "#/$defs/RawEvidence"
        },
        "posts": {
          "type": "array",
          "maxItems": 10000
        },
        "articles": {
          "type": "array",
          "maxItems": 1000
        }
      },
      "required": [
        "raw",
        "posts",
        "articles"
      ],
      "additionalProperties": true
    }
  }
}
