{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "job": {
      "type": "object",
      "properties": {
        "jobId": {
          "type": "string",
          "pattern": "^([0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[1-8][0-9a-fA-F]{3}-[89abAB][0-9a-fA-F]{3}-[0-9a-fA-F]{12}|00000000-0000-0000-0000-000000000000|[fF]{8}-[fF]{4}-[fF]{4}-[fF]{4}-[fF]{12})$",
          "format": "uuid"
        },
        "namespace": {
          "type": "string",
          "enum": [
            "staging",
            "production"
          ]
        },
        "startedAt": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991
        },
        "deadline": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991
        }
      },
      "required": [
        "jobId",
        "namespace",
        "startedAt",
        "deadline"
      ],
      "additionalProperties": true
    },
    "planKey": {
      "type": "string",
      "minLength": 1,
      "maxLength": 512
    },
    "inputJson": {
      "type": "string",
      "maxLength": 65536
    },
    "chargeNanos": {
      "type": "integer",
      "minimum": 0,
      "maximum": 9007199254740991
    },
    "platformNanos": {
      "type": "integer",
      "minimum": 0,
      "maximum": 9007199254740991
    },
    "retrievalNanos": {
      "type": "integer",
      "minimum": 0,
      "maximum": 9007199254740991
    },
    "replacementOf": {
      "anyOf": [
        {
          "type": "string",
          "pattern": "^([0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[1-8][0-9a-fA-F]{3}-[89abAB][0-9a-fA-F]{3}-[0-9a-fA-F]{12}|00000000-0000-0000-0000-000000000000|[fF]{8}-[fF]{4}-[fF]{4}-[fF]{4}-[fF]{12})$",
          "format": "uuid"
        },
        {
          "type": "null"
        }
      ]
    }
  },
  "required": [
    "job",
    "planKey",
    "inputJson",
    "chargeNanos",
    "platformNanos",
    "retrievalNanos",
    "replacementOf"
  ],
  "additionalProperties": true,
  "$defs": {}
}
