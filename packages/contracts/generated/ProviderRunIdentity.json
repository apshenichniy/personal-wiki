{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "runId": {
      "type": "string",
      "minLength": 1,
      "maxLength": 512
    },
    "datasetId": {
      "type": "string",
      "minLength": 1,
      "maxLength": 512
    },
    "keyValueStoreId": {
      "type": "string",
      "minLength": 1,
      "maxLength": 512
    },
    "buildId": {
      "type": "string",
      "minLength": 1,
