{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "anyOf": [
    {
      "type": "object",
      "properties": {
        "scope": {
          "$ref": "#/$defs/JobScope"
        },
        "job": {
          "$ref": "#/$defs/JobView"
        },
        "capture": {
          "anyOf": [
            {
              "type": "object",
              "properties": {
                "draft": {
                  "$ref": "#/$defs/Draft"
                },
                "captures": {
                  "type": "array",
                  "items": {
                    "$ref": "#/$defs/Capture"
                  },
                  "minItems": 1,
                  "maxItems": 2
                }
              },
              "required": [
                "draft",
                "captures"
              ],
              "additionalProperties": true
            },
            {
              "type": "null"
            }
          ]
        },
        "nextReason": {
          "type": "string",
          "enum": [
            "initial",
            "repair",
            "transient",
            "stale"
          ]
        }
      },
      "required": [
        "scope",
        "job",
        "capture",
        "nextReason"
      ],
      "additionalProperties": true
    },
    {
      "type": "null"
    }
  ],
  "$defs": {
    "JobScope": {
      "type": "object",
      "properties": {
        "jobId": {
          "type": "string",
          "pattern": "^([0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[1-8][0-9a-fA-F]{3}-[89abAB][0-9a-fA-F]{3}-[0-9a-fA-F]{12}|00000000-0000-0000-0000-000000000000|[fF]{8}-[fF]{4}-[fF]{4}-[fF]{4}-[fF]{12})$",
          "format": "uuid"
        },
        "instanceId": {
          "type": "string",
          "pattern": "^([0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[1-8][0-9a-fA-F]{3}-[89abAB][0-9a-fA-F]{3}-[0-9a-fA-F]{12}|00000000-0000-0000-0000-000000000000|[fF]{8}-[fF]{4}-[fF]{4}-[fF]{4}-[fF]{12})$",
          "format": "uuid"
        },
        "epoch": {
          "type": "integer",
          "maximum": 9007199254740991,
          "exclusiveMinimum": 0
        }
      },
      "required": [
        "jobId",
        "instanceId",
        "epoch"
      ],
      "additionalProperties": true
    },
    "ExecutionPolicy": {
      "type": "object",
      "properties": {
        "version": {
          "type": "string",
          "enum": [
            "execution-v1"
          ]
        },
        "activeJobMs": {
          "type": "integer",
          "maximum": 9007199254740991,
          "exclusiveMinimum": 0
        },
        "attemptMs": {
          "type": "integer",
          "maximum": 9007199254740991,
          "exclusiveMinimum": 0
        },
        "maxLaunches": {
          "type": "number",
          "enum": [
            3
          ]
        },
        "maxRepair": {
          "type": "number",
          "enum": [
            1
          ]
        },
        "maxTransient": {
          "type": "number",
          "enum": [
            1
          ]
        },
        "maxStale": {
          "type": "number",
          "enum": [
            1
          ]
        }
      },
      "required": [
        "version",
        "activeJobMs",
        "attemptMs",
        "maxLaunches",
        "maxRepair",
        "maxTransient",
        "maxStale"
      ],
      "additionalProperties": true
    },
    "ExecutionCounters": {
      "type": "object",
      "properties": {
        "launches": {
          "type": "integer",
          "minimum": 0,
          "maximum": 3
        },
        "repair": {
          "type": "integer",
          "minimum": 0,
          "maximum": 1
        },
        "transient": {
          "type": "integer",
          "minimum": 0,
          "maximum": 1
        },
        "stale": {
          "type": "integer",
          "minimum": 0,
          "maximum": 1
        }
      },
      "required": [
        "launches",
        "repair",
        "transient",
        "stale"
      ],
      "additionalProperties": true
    },
    "Receipt": {
      "type": "object",
      "properties": {
        "schemaVersion": {
          "type": "number",
          "enum": [
            1
          ]
        },
        "operationId": {
          "type": "string",
          "pattern": "^([0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[1-8][0-9a-fA-F]{3}-[89abAB][0-9a-fA-F]{3}-[0-9a-fA-F]{12}|00000000-0000-0000-0000-000000000000|[fF]{8}-[fF]{4}-[fF]{4}-[fF]{4}-[fF]{12})$",
          "format": "uuid"
        },
        "publicationId": {
          "type": "string",
          "pattern": "^([0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[1-8][0-9a-fA-F]{3}-[89abAB][0-9a-fA-F]{3}-[0-9a-fA-F]{12}|00000000-0000-0000-0000-000000000000|[fF]{8}-[fF]{4}-[fF]{4}-[fF]{4}-[fF]{12})$",
          "format": "uuid"
        },
        "jobId": {
          "type": "string",
          "pattern": "^([0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[1-8][0-9a-fA-F]{3}-[89abAB][0-9a-fA-F]{3}-[0-9a-fA-F]{12}|00000000-0000-0000-0000-000000000000|[fF]{8}-[fF]{4}-[fF]{4}-[fF]{4}-[fF]{12})$",
          "format": "uuid"
        },
        "appliedRevision": {
          "type": "string"
        },
        "sequence": {
          "type": "integer",
          "minimum": -9007199254740991,
          "maximum": 9007199254740991
        },
        "noteIds": {
          "type": "array",
          "items": {
            "type": "string",
            "pattern": "^([0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[1-8][0-9a-fA-F]{3}-[89abAB][0-9a-fA-F]{3}-[0-9a-fA-F]{12}|00000000-0000-0000-0000-000000000000|[fF]{8}-[fF]{4}-[fF]{4}-[fF]{4}-[fF]{12})$",
            "format": "uuid"
          }
        },
        "publishedAt": {
          "type": "string"
        }
      },
      "required": [
        "schemaVersion",
        "operationId",
        "publicationId",
        "jobId",
        "appliedRevision",
        "sequence",
        "noteIds",
        "publishedAt"
      ],
      "additionalProperties": true
    },
    "JobView": {
      "type": "object",
      "properties": {
        "schemaVersion": {
          "type": "number",
          "enum": [
            1
          ]
        },
        "jobId": {
          "type": "string",
          "pattern": "^([0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[1-8][0-9a-fA-F]{3}-[89abAB][0-9a-fA-F]{3}-[0-9a-fA-F]{12}|00000000-0000-0000-0000-000000000000|[fF]{8}-[fF]{4}-[fF]{4}-[fF]{4}-[fF]{12})$",
          "format": "uuid"
        },
        "stage": {
          "type": "string",
          "enum": [
            "queued",
            "acquiring",
            "prepared",
            "curating",
            "validating",
            "publishing",
            "blocked",
            "stopping",
            "succeeded",
            "failed",
            "expired",
            "cancelled"
          ]
        },
        "submittedUrl": {
          "type": "string"
        },
        "normalizedUrl": {
          "type": "string"
        },
        "anchorId": {
          "type": "string"
        },
        "sourceKey": {
          "type": "string"
        },
        "createdAt": {
          "type": "string"
        },
        "startedAt": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ]
        },
        "deadline": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ]
        },
        "policy": {
          "$ref": "#/$defs/ExecutionPolicy"
        },
        "counters": {
          "$ref": "#/$defs/ExecutionCounters"
        },
        "reason": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ]
        },
        "warnings": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "allowedActions": {
          "type": "array",
          "items": {
            "type": "string",
            "enum": [
              "cancel",
              "resume",
              "retry_retained",
              "refresh"
            ]
          }
        },
        "receipt": {
          "anyOf": [
            {
              "$ref": "#/$defs/Receipt"
            },
            {
              "type": "null"
            }
          ]
        },
        "previousJobId": {
          "anyOf": [
            {
              "type": "string",
              "pattern": "^([0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[1-8][0-9a-fA-F]{3}-[89abAB][0-9a-fA-F]{3}-[0-9a-fA-F]{12}|00000000-0000-0000-0000-000000000000|[fF]{8}-[fF]{4}-[fF]{4}-[fF]{4}-[fF]{12})$",
              "format": "uuid"
            },
            {
              "type": "null"
            }
          ]
        },
        "retainedCapture": {
          "type": "boolean"
        },
        "cleanupPending": {
          "type": "boolean"
        }
      },
      "required": [
        "schemaVersion",
        "jobId",
        "stage",
        "submittedUrl",
        "normalizedUrl",
        "anchorId",
        "sourceKey",
        "createdAt",
        "startedAt",
        "deadline",
        "policy",
        "counters",
        "reason",
        "warnings",
        "allowedActions",
        "receipt",
        "previousJobId",
        "retainedCapture",
        "cleanupPending"
      ],
      "additionalProperties": true
    },
    "Source": {
      "type": "object",
      "properties": {
        "schemaVersion": {
          "type": "number",
          "enum": [
            1
          ]
        },
        "sourceId": {
          "type": "string",
          "pattern": "^([0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[1-8][0-9a-fA-F]{3}-[89abAB][0-9a-fA-F]{3}-[0-9a-fA-F]{12}|00000000-0000-0000-0000-000000000000|[fF]{8}-[fF]{4}-[fF]{4}-[fF]{4}-[fF]{12})$",
          "format": "uuid"
        },
        "kind": {
          "type": "string",
          "enum": [
            "x_post",
            "x_author_thread",
            "x_article"
          ]
        },
        "primaryId": {
          "type": "string"
        },
        "aliases": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "maxItems": 50
        },
        "resolution": {
          "type": "string",
          "enum": [
            "resolved",
            "uncertain"
          ]
        },
        "externalKey": {
          "type": "string"
        },
        "canonicalUrl": {
          "type": "string"
        }
      },
      "required": [
        "schemaVersion",
        "sourceId",
        "kind",
        "primaryId",
        "aliases",
        "resolution",
        "externalKey",
        "canonicalUrl"
      ],
      "additionalProperties": true
    },
    "Slot": {
      "type": "object",
      "properties": {
        "source": {
          "$ref": "#/$defs/Source"
        },
        "noteId": {
          "type": "string",
          "pattern": "^([0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[1-8][0-9a-fA-F]{3}-[89abAB][0-9a-fA-F]{3}-[0-9a-fA-F]{12}|00000000-0000-0000-0000-000000000000|[fF]{8}-[fF]{4}-[fF]{4}-[fF]{4}-[fF]{12})$",
          "format": "uuid"
        },
        "captureId": {
          "type": "string",
          "pattern": "^([0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[1-8][0-9a-fA-F]{3}-[89abAB][0-9a-fA-F]{3}-[0-9a-fA-F]{12}|00000000-0000-0000-0000-000000000000|[fF]{8}-[fF]{4}-[fF]{4}-[fF]{4}-[fF]{12})$",
          "format": "uuid"
        },
        "representationId": {
          "type": "string",
          "pattern": "^([0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[1-8][0-9a-fA-F]{3}-[89abAB][0-9a-fA-F]{3}-[0-9a-fA-F]{12}|00000000-0000-0000-0000-000000000000|[fF]{8}-[fF]{4}-[fF]{4}-[fF]{4}-[fF]{12})$",
          "format": "uuid"
        },
        "assetId": {
          "type": "string",
          "pattern": "^([0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[1-8][0-9a-fA-F]{3}-[89abAB][0-9a-fA-F]{3}-[0-9a-fA-F]{12}|00000000-0000-0000-0000-000000000000|[fF]{8}-[fF]{4}-[fF]{4}-[fF]{4}-[fF]{12})$",
          "format": "uuid"
        }
      },
      "required": [
        "source",
        "noteId",
        "captureId",
        "representationId",
        "assetId"
      ],
      "additionalProperties": true
    },
    "Draft": {
      "type": "object",
      "properties": {
        "schemaVersion": {
          "type": "number",
          "enum": [
            1
          ]
        },
        "jobId": {
          "type": "string",
          "pattern": "^([0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[1-8][0-9a-fA-F]{3}-[89abAB][0-9a-fA-F]{3}-[0-9a-fA-F]{12}|00000000-0000-0000-0000-000000000000|[fF]{8}-[fF]{4}-[fF]{4}-[fF]{4}-[fF]{12})$",
          "format": "uuid"
        },
        "slots": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/Slot"
          }
        }
      },
      "required": [
        "schemaVersion",
        "jobId",
        "slots"
      ],
      "additionalProperties": true
    },
    "Observation": {
      "type": "object",
      "properties": {
        "providerId": {
          "type": "string"
        },
        "canonicalUrl": {
          "type": "string"
        },
        "text": {
          "type": "string",
          "maxLength": 1048576
        },
        "authorId": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ]
        },
        "parentId": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ]
        },
        "conversationId": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ]
        },
        "quotedId": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ]
        },
        "articleId": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ]
        },
        "postedAt": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ]
        }
      },
      "required": [
        "providerId",
        "canonicalUrl",
        "text",
        "authorId",
        "parentId",
        "conversationId",
        "quotedId",
        "articleId",
        "postedAt"
      ],
      "additionalProperties": true
    },
    "Representation": {
      "type": "object",
      "properties": {
        "schemaVersion": {
          "type": "number",
          "enum": [
            1
          ]
        },
        "representationId": {
          "type": "string",
          "pattern": "^([0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[1-8][0-9a-fA-F]{3}-[89abAB][0-9a-fA-F]{3}-[0-9a-fA-F]{12}|00000000-0000-0000-0000-000000000000|[fF]{8}-[fF]{4}-[fF]{4}-[fF]{4}-[fF]{12})$",
          "format": "uuid"
        },
        "captureId": {
          "type": "string",
          "pattern": "^([0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[1-8][0-9a-fA-F]{3}-[89abAB][0-9a-fA-F]{3}-[0-9a-fA-F]{12}|00000000-0000-0000-0000-000000000000|[fF]{8}-[fF]{4}-[fF]{4}-[fF]{4}-[fF]{12})$",
          "format": "uuid"
        },
        "assetId": {
          "type": "string",
          "pattern": "^([0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[1-8][0-9a-fA-F]{3}-[89abAB][0-9a-fA-F]{3}-[0-9a-fA-F]{12}|00000000-0000-0000-0000-000000000000|[fF]{8}-[fF]{4}-[fF]{4}-[fF]{4}-[fF]{12})$",
          "format": "uuid"
        },
        "language": {
          "type": "string",
          "minLength": 1,
          "maxLength": 35
        },
        "kind": {
          "type": "string",
          "enum": [
            "original_text",
            "extracted_text",
            "translation"
          ]
        },
        "text": {
          "type": "string",
          "maxLength": 1048576
        },
        "derivation": {
          "type": "string",
          "maxLength": 512
        }
      },
      "required": [
        "schemaVersion",
        "representationId",
        "captureId",
        "assetId",
        "language",
        "kind",
        "text",
        "derivation"
      ],
      "additionalProperties": true
    },
    "Capture": {
      "type": "object",
      "properties": {
        "schemaVersion": {
          "type": "number",
          "enum": [
            1
          ]
        },
        "captureId": {
          "type": "string",
          "pattern": "^([0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[1-8][0-9a-fA-F]{3}-[89abAB][0-9a-fA-F]{3}-[0-9a-fA-F]{12}|00000000-0000-0000-0000-000000000000|[fF]{8}-[fF]{4}-[fF]{4}-[fF]{4}-[fF]{12})$",
          "format": "uuid"
        },
        "sourceId": {
          "type": "string",
          "pattern": "^([0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[1-8][0-9a-fA-F]{3}-[89abAB][0-9a-fA-F]{3}-[0-9a-fA-F]{12}|00000000-0000-0000-0000-000000000000|[fF]{8}-[fF]{4}-[fF]{4}-[fF]{4}-[fF]{12})$",
          "format": "uuid"
        },
        "startedAt": {
          "type": "string"
        },
        "endedAt": {
          "type": "string"
        },
        "submittedUrl": {
          "type": "string"
        },
        "submittedAnchorId": {
          "type": "string"
        },
        "focusIds": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "observations": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/Observation"
          },
          "maxItems": 300
        },
        "assetIds": {
          "type": "array",
          "items": {
            "type": "string",
            "pattern": "^([0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[1-8][0-9a-fA-F]{3}-[89abAB][0-9a-fA-F]{3}-[0-9a-fA-F]{12}|00000000-0000-0000-0000-000000000000|[fF]{8}-[fF]{4}-[fF]{4}-[fF]{4}-[fF]{12})$",
            "format": "uuid"
          }
        },
        "representations": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/Representation"
          }
        },
        "provenance": {
          "type": "object",
          "properties": {
            "provider": {
              "type": "string"
            },
            "runIds": {
              "type": "array",
              "items": {
                "type": "string"
              }
            },
            "policyVersion": {
              "type": "string"
            }
          },
          "required": [
            "provider",
            "runIds",
            "policyVersion"
          ],
          "additionalProperties": true
        },
        "coverage": {
          "type": "object",
          "properties": {
            "main": {
              "type": "string"
            },
            "discussion": {
              "type": "string"
            },
            "context": {
              "type": "string"
            }
          },
          "required": [
            "main",
            "discussion",
            "context"
          ],
          "additionalProperties": true
        },
        "warnings": {
          "type": "array",
          "items": {
            "type": "string"
          }
        }
      },
      "required": [
        "schemaVersion",
        "captureId",
        "sourceId",
        "startedAt",
        "endedAt",
        "submittedUrl",
        "submittedAnchorId",
        "focusIds",
        "observations",
        "assetIds",
        "representations",
        "provenance",
        "coverage",
        "warnings"
      ],
      "additionalProperties": true
    }
  }
}
