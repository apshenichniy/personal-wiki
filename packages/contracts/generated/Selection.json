{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "postId": {
      "type": "string"
    },
    "decision": {
      "type": "string",
      "enum": [
        "include",
        "omit",
        "consolidate"
      ]
    },
    "reason": {
      "type": "string",
      "minLength": 1,
      "maxLength": 500
    }
  },
  "required": [
    "postId",
    "decision",
    "reason"
  ],
  "additionalProperties": true,
  "$defs": {}
}
