{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$ref": "#/$defs/XPost",
  "$defs": {
    "XPost": {
      "type": "object",
      "properties": {
        "authorHandle": {
          "anyOf": [
            {
              "anyOf": [
                {
                  "type": "string",
                  "maxLength": 128
                },
                {
                  "type": "null"
                }
              ]
            },
            {
              "type": "null"
            }
          ]
        },
        "authorName": {
          "anyOf": [
            {
              "anyOf": [
                {
                  "type": "string",
                  "maxLength": 256
                },
                {
                  "type": "null"
                }
              ]
            },
            {
              "type": "null"
            }
          ]
        },
        "id": {
          "type": "string"
        },
        "authorId": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ]
        },
        "parentId": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ]
        },
        "parentStatus": {
          "type": "string",
          "enum": [
            "root",
            "reply",
            "unknown"
          ]
        },
        "conversationId": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ]
        },
        "text": {
          "type": "string",
          "maxLength": 16777216
        },
        "longText": {
          "anyOf": [
            {
              "type": "string",
              "maxLength": 16777216
            },
            {
              "type": "null"
            }
          ]
        },
        "language": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ]
        },
        "quotedId": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ]
        },
        "articleId": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ]
        },
        "postedAt": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ]
        },
        "isBot": {
          "anyOf": [
            {
              "type": "boolean"
            },
            {
              "type": "null"
            }
          ]
        },
        "references": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "kind": {
                "type": "string",
                "enum": [
                  "external_page",
                  "image",
                  "video",
                  "audio"
                ]
              },
              "url": {
                "type": "string"
              }
            },
            "required": [
              "kind",
              "url"
            ],
            "additionalProperties": true
          }
        }
      },
      "required": [
        "id",
        "authorId",
        "parentId",
        "parentStatus",
        "conversationId",
        "text",
        "longText",
        "language",
        "quotedId",
        "articleId",
        "postedAt",
        "isBot",
        "references"
      ],
      "additionalProperties": true
    }
  }
}
